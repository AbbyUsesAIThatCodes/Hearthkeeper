QWidget { font-family: "Segoe UI", "DejaVu Sans"; font-size: 14px; color: #263d33; }
QMainWindow, QDialog { background: #f4f0e7; }
QFrame#sidebar { background: #193e32; border: 0; }
QFrame#sidebar QLabel { color: #eddfbd; background: transparent; }
QLabel#brand { font-family: Georgia; font-size: 20px; font-weight: bold; }
QLabel#brandSub { font-size: 11px; color: #b9c8b5; }
QPushButton#nav { text-align: left; border: 0; padding: 13px 17px; color: #e1e7d9; background: transparent; border-radius: 7px; }
QPushButton#nav:checked { background: #345948; color: #ffe1a1; font-weight: bold; }
QPushButton#nav:hover { background: #2a503f; }
QLabel#title { font-family: Georgia; font-size: 30px; color: #193e32; }
QLabel#eyebrow { font-size: 11px; font-weight: bold; color: #847143; }
QLabel#muted { color: #667366; }
QLabel#status { background: #e5eadd; border-radius: 7px; padding: 12px; }
QFrame#card { background: #fffdf7; border: 1px solid #ded7c7; border-radius: 10px; }
QFrame#card QLabel { background: transparent; }
QLabel#cardTitle { color: #7a7059; font-size: 12px; }
QLabel#cardValue { font-family: Georgia; font-size: 21px; }
QPushButton { background: #fffdf7; border: 1px solid #cfc6b2; border-radius: 6px; padding: 9px 14px; }
QPushButton:hover { background: #e9eddf; border-color: #8b9f84; }
QPushButton:pressed { background: #d8e2ce; }
QPushButton:disabled { color: #9a9b91; background: #ecebe5; border-color: #d9d7cf; }
QPushButton#primary { background: #265540; color: #fff6df; border-color: #265540; font-weight: bold; }
QPushButton#primary:hover { background: #376b50; }
QPushButton#primary:disabled { color: #9a9b91; background: #ecebe5; border-color: #d9d7cf; }
QLineEdit, QSpinBox, QComboBox { background: #fffef9; border: 1px solid #ccc5b5; border-radius: 5px; padding: 7px; selection-background-color: #42694f; }
QLineEdit:focus, QSpinBox:focus { border: 1px solid #4a7658; }
QPlainTextEdit { background: #fffdf8; border: 1px solid #ddd6c7; border-radius: 6px; font-family: Consolas, monospace; font-size: 12px; }
QPlainTextEdit#activity { background: #213a30; color: #d8e2d2; border: 0; }
QTableWidget, QTreeWidget { background: #fffef9; alternate-background-color: #f4f2e9; border: 1px solid #ddd7c8; selection-background-color: #d6e3cb; selection-color: #1c372b; gridline-color: #e8e3d6; }
QHeaderView::section { background: #e9ebdf; border: 0; padding: 9px; text-align: left; font-weight: bold; }
QTabWidget::pane { border: 1px solid #ddd7c8; background: #fffef9; }
QTabBar::tab { background: #e8e6db; padding: 9px 14px; border-top-left-radius: 5px; border-top-right-radius: 5px; }
QTabBar::tab:selected { background: #fffef9; color: #244d37; font-weight: bold; }
QProgressBar { background: #e2e7d9; border: 0; border-radius: 3px; min-height: 5px; max-height: 5px; }
QProgressBar::chunk { background: #b79045; }
QSplitter::handle { background: #dedccd; height: 6px; }
QScrollArea { background: transparent; border: 0; }
