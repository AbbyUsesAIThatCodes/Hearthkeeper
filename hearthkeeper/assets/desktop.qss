QWidget { font-family: "Segoe UI", "DejaVu Sans"; font-size: 13px; color: #e2d8bc; background: #182126; }
QMainWindow, QDialog { background: #182126; }
QWidget#root { background: #182126; }
QFrame#sidebar { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #151b1e,stop:1 #202b2e); border-right: 2px solid #705a35; }
QFrame#sidebar QLabel { color: #cbb477; background: transparent; }
QLabel#brand { font-family: Georgia, "DejaVu Serif"; font-size: 20px; font-weight: bold; color: #f0dba0; }
QLabel#brandSub { font-size: 10px; color: #9d9f92; }
QPushButton#nav { text-align: left; border: 1px solid transparent; padding: 12px 10px; color: #bbc0b7; background: transparent; border-radius: 2px; }
QPushButton#nav:checked { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #4a3a23,stop:1 #28302c); color: #ffe2a0; border: 1px solid #826b3d; font-weight: bold; }
QPushButton#nav:hover { background: #303c3c; border-color: #71603c; }
QLabel#title { font-family: Georgia, "DejaVu Serif"; font-size: 28px; color: #e9cd8a; }
QLabel#eyebrow { font-size: 10px; font-weight: bold; color: #c1a465; }
QLabel#muted { color: #a6b2af; }
QLabel#status { background: #263438; border: 1px solid #53605a; border-radius: 2px; padding: 12px; }
QFrame#card { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #303d40,stop:1 #222e32); border: 1px solid #6e6248; border-radius: 3px; }
QFrame#card QLabel { background: transparent; border: 0; }
QLabel#cardTitle { color: #b9a579; font-size: 10px; font-weight: bold; }
QLabel#cardValue { font-family: Georgia, "DejaVu Serif"; font-size: 18px; color: #eee0b9; }
QFrame#hero { border-image: url("__ASSETS__/winter-gate.svg") 0 0 0 0 stretch stretch; border: 1px solid #917948; }
QFrame#hero QLabel { background: transparent; border: 0; }
QLabel#heroTitle { font-family: Georgia, "DejaVu Serif"; font-size: 36px; color: #f4deb0; }
QLabel#heroSubtitle { color: #bccdcb; font-size: 13px; }
QFrame#parchment { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #e5d3a5,stop:1 #c5ae7d); border: 2px solid #806336; border-radius: 2px; }
QFrame#parchment QLabel { background: transparent; color: #433924; border: 0; }
QFrame#parchment QLabel#eyebrow { color: #725632; }
QFrame#parchment QLabel#clientTitle { font-family: Georgia, "DejaVu Serif"; font-size: 20px; color: #302b21; }
QPushButton { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #3b4545,stop:.5 #2a3538,stop:1 #232c30); border: 1px solid #7b6b49; border-radius: 3px; padding: 8px 12px; color: #e8d9b0; }
QPushButton:hover { background: #47524c; border-color: #d1b777; color: #fff0bd; }
QPushButton:pressed { background: #1b272b; border-color: #b29154; }
QPushButton:focus { border: 2px solid #e9c777; }
QPushButton:disabled { color: #808781; background: #293135; border-color: #49514c; }
QPushButton#primary, QPushButton#play { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #a53728,stop:.46 #76241f,stop:1 #4d1919); border: 2px solid #c49b51; color: #ffdfa0; font-weight: bold; }
QPushButton#primary:hover, QPushButton#play:hover { background: #aa3e29; border-color: #f2d089; }
QPushButton#primary:disabled, QPushButton#play:disabled { color: #9d988b; background: #453b36; border-color: #796849; }
QPushButton#play { font-family: Georgia, "DejaVu Serif"; font-size: 23px; min-height: 34px; padding: 10px 30px; }
QLineEdit, QSpinBox, QComboBox { background: #142329; border: 1px solid #756c51; border-radius: 2px; padding: 7px; color: #e9dfc5; selection-background-color: #695533; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #e1bf73; }
QComboBox QAbstractItemView { background: #233236; color: #e9dfc5; selection-background-color: #655333; }
QPlainTextEdit { background: #16262b; color: #c4d1cb; border: 1px solid #5c6458; border-radius: 2px; font-family: Consolas, monospace; font-size: 12px; }
QPlainTextEdit#activity { background: #111e23; color: #9fb5b1; border: 1px solid #3f514e; }
QTableWidget, QTreeWidget { background: #1b2b30; alternate-background-color: #22343a; border: 1px solid #5a6358; selection-background-color: #645437; selection-color: #fff0c4; gridline-color: #354849; }
QHeaderView::section { background: #374340; color: #dfc68e; border: 0; border-bottom: 1px solid #8a744c; padding: 9px; font-weight: bold; }
QTabWidget::pane { border: 1px solid #716343; background: #1c2b30; }
QTabBar::tab { background: #2a3638; color: #bcc0ad; padding: 9px 13px; border: 1px solid #5f624d; }
QTabBar::tab:selected { background: #51462e; color: #ffe1a0; border-bottom: 2px solid #c9a55d; }
QProgressBar { background: #15252b; border: 1px solid #756544; min-height: 6px; max-height: 6px; }
QProgressBar::chunk { background: #c9a254; }
QSplitter::handle { background: #534a35; height: 4px; }
QScrollArea { background: transparent; border: 0; }
QScrollBar:vertical { background: #1b292e; width: 12px; }
QScrollBar::handle:vertical { background: #746447; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QCheckBox { spacing: 7px; }
QToolTip { background: #13212a; color: #f2db9c; border: 1px solid #b49855; padding: 7px; }

QLabel { background: transparent; }
